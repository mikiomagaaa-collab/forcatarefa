<?xml version="1.0" encoding="utf-8"?>
<!--
    Modo de precisão da Liquid Island (opcional). Recebe eventos só da interface do sistema e lê
    apenas a barra de status, para a ilha nunca cobrir o relógio e os ícones.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/precision_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="300"
    android:packageNames="com.android.systemui"
    android:summary="@string/precision_summary" />
