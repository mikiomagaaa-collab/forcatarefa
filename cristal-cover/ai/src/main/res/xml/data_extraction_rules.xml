<?xml version="1.0" encoding="utf-8"?>
<!-- Conversas, memórias e modelos ficam só no aparelho: nada vai para backup na nuvem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
